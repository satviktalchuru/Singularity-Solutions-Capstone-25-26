# Copy this file to `.env` and fill in your own values. Nothing here is
# required to run the scraper -- output goes to a local CSV
# (listings.csv), no credentials needed. These are purely optional and only
# raise rate limits / unlock one extra source.
# `.env` is git-ignored -- never commit real values here anyway.

# GitHub personal access token (free): raises the API limit from 60 to 5000
# requests/hour. Public-repo read scope is enough. Leave blank to still work,
# just more likely to get rate-limited on busy days.
GITHUB_TOKEN=

# Google Programmable Search Engine (free tier: 100 queries/day). Only used
# for the LinkedIn-via-Google-CSE job_boards source.
#   API key: https://developers.google.com/custom-search/v1/overview
#   CX id:   https://programmablesearchengine.google.com/
# Leave blank to skip that one source; everything else still runs.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
