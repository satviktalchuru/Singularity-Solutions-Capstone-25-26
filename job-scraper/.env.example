# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored -- never commit real credentials.

# ---------------------------------------------------------------------------
# Gmail (used only as an SMTP relay for the email-to-SMS digest).
# Create a free App Password at https://myaccount.google.com/apppasswords
# (requires 2FA on the account). Do NOT use your normal Gmail password.
# ---------------------------------------------------------------------------
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where the digest lands. Email-to-SMS gateways by US carrier:
#   Verizon:  <number>@vtext.com      AT&T:    <number>@txt.att.net
#   T-Mobile: <number>@tmomail.net    Cricket: <number>@sms.cricketwireless.net
# You can list several recipients separated by commas (e.g. add your inbox
# as a second recipient to keep a full-length copy of the digest).
NOTIFY_RECIPIENTS=5551234567@vtext.com,you@gmail.com

# ---------------------------------------------------------------------------
# Optional tokens -- everything still works without them, just rate-limited.
# ---------------------------------------------------------------------------
# GitHub personal access token (free): raises the API limit from 60 to 5000
# requests/hour. Public-repo read scope is enough.
GITHUB_TOKEN=

# Google Programmable Search Engine (free tier: 100 queries/day).
#   API key: https://developers.google.com/custom-search/v1/overview
#   CX id:   https://programmablesearchengine.google.com/
# Leave blank to skip the Google CSE job-board source.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
